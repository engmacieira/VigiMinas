rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra padrão de negação
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdminMaster() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin_master' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.funcao == 'admin_master'
      );
    }

    function isOwner(usuarioId) {
      return isAuthenticated() && request.auth.uid == usuarioId;
    }

    // Coleção de Estabelecimentos (Indicadores 12, 13, 14, 15)
    match /estabelecimentos/{estabelecimentoId} {
      allow read: if true;
      allow create, update: if isValidId(estabelecimentoId) &&
        request.resource.data.razaoSocial is string &&
        request.resource.data.razaoSocial.size() > 0 &&
        request.resource.data.nivelRisco in ['Risco I', 'Risco II', 'Risco III'];
      allow delete: if isValidId(estabelecimentoId);
    }

    // Coleção de Inspeções VAPT (Indicador 11 - Saúde do Trabalhador)
    match /inspecoes_vapt/{inspecaoId} {
      allow read: if true;
      allow create, update: if isValidId(inspecaoId) &&
        request.resource.data.estabelecimentoId is string &&
        request.resource.data.nomeLocalTrabalho is string;
      allow delete: if isValidId(inspecaoId);
    }

    // Coleção de Logs de Auditoria e Transparência Fiscalizatória (Middleware)
    match /logs_auditoria/{logId} {
      allow read: if isAuthenticated();
      allow create: if isValidId(logId) &&
        request.resource.data.recursoId is string &&
        request.resource.data.operacao is string &&
        request.resource.data.colecao is string &&
        (!('usuarioId' in request.resource.data) || request.resource.data.usuarioId == request.auth.uid);
      allow update: if false; // Logs são estritamente imutáveis (append-only)
      allow delete: if false; // Proibida a exclusão de logs de auditoria
    }

    // Coleção de Configurações Gerais do Sistema e Secretaria
    match /configuracoes_sistema/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) &&
        request.resource.data.secretaria is map &&
        request.resource.data.exercicioAtivo is map;
      allow delete: if false; // Configurações gerais não devem ser deletadas
    }

    // Coleção de Usuários e Perfis de Acesso (RBAC)
    match /usuarios/{usuarioId} {
      allow read: if isAuthenticated() && (isOwner(usuarioId) || isAdminMaster());
      allow create: if isAuthenticated() && isAdminMaster() && isValidId(usuarioId) &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.funcao in ['admin_master', 'fiscal_tecnico', 'digitador'];
      allow update: if isAuthenticated() && isValidId(usuarioId) && (
        isAdminMaster() || (
          isOwner(usuarioId) &&
          request.resource.data.funcao == resource.data.funcao &&
          request.resource.data.ativo == resource.data.ativo
        )
      );
      allow delete: if isAuthenticated() && isAdminMaster() && isValidId(usuarioId);
    }
  }
}
